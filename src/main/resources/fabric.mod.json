{
  "schemaVersion": 1,
  "id": "mikumiku",
  "version": "${version}",
  "name": "Miku Addon",
  "description": "Miku addon for Evernight: the modules meteor-miku offers that Evernight does not already have (build, movement tweaks, utility, HUD).",
  "authors": [
    "mikumiku",
    "Evernight port"
  ],
  "environment": "client",
  "entrypoints": {
    "evernight-addon": [
      "com.github.mikumiku.evernight.MikuAddon"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "evernight": ">=1.0.3"
  }
}
